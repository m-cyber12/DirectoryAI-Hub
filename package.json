{
  "name": "creator-ai-hub",
  "version": "0.3.0",
  "private": true,
  "description": "Curated AI tools directory for YouTubers, editors, and video creators — with transparent verification levels.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{json,js,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "validate:data": "node scripts/validate-data.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run validate:data && npm run test",
    "curate": "node scripts/auto-curate.mjs",
    "generate:blog": "node scripts/generate-blog.mjs",
    "translate:ui": "tsx scripts/translate.mts --ui",
    "translate:content": "tsx scripts/translate.mts --content",
    "translate:status": "tsx scripts/translate.mts --status"
  },
  "dependencies": {
    "@extractus/article-extractor": "^9.0.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.4",
    "@supabase/supabase-js": "^2.47.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lucide-react": "^0.470.0",
    "next": "^15.0.0",
    "next-intl": "^4.13.5",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.18.1",
    "server-only": "^0.0.1",
    "three": "^0.185.1",
    "tsx": "^4.23.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "postcss": "^8.4.40",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  },
  "browserslist": [
    "chrome >= 111",
    "safari >= 16.4",
    "firefox >= 111",
    "edge >= 111"
  ]
}
