# ─────────────────────────────────────────────────────────────────────────
#  CreatorAI Hub — environment variables
#  Copy to .env.local for development. Set the same keys in
#  Vercel → Settings → Environment Variables for production.
#
#  The site builds and runs with NONE of these set: it falls back to the
#  static catalog. Each variable below unlocks a specific feature.
# ─────────────────────────────────────────────────────────────────────────

# ── Site identity ────────────────────────────────────────────────────────
# Audit fix 1.10 — the URL used to be hardcoded in 5 files. Set this once
# when you move to a custom domain; sitemap, robots, canonicals, RSS,
# llms.txt and OG tags all read from it.
NEXT_PUBLIC_SITE_URL=https://creaorsaicenter.vercel.app

# Shown on /contact and in Organization schema. Defaults to hello@<your host>,
# so it can never contradict the domain the site is served from.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.com


# ── Supabase: public (browser-visible) ───────────────────────────────────
# Safe to expose. Used for reading approved reviews and for auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ── Supabase: server only  ⚠️ NEVER PREFIX WITH NEXT_PUBLIC_ ─────────────
# Audit fix 1.3. All database WRITES now go through this key from server
# code only, because migration 0003 revokes write access from the anon role.
# Without it: reviews, submissions, newsletter signups and click logging
# will silently stop working.
#   Supabase dashboard → Project Settings → API → service_role
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# ── Admin panel ──────────────────────────────────────────────────────────
# The password used to sign in at /admin.
ADMIN_PASSWORD=

# Audit fix 6.2 — the session cookie used to contain the password itself.
# It now holds an HMAC-signed token. Use a SEPARATE random secret here:
#   openssl rand -hex 32
# Rotating this value invalidates every existing admin session.
ADMIN_SESSION_SECRET=


# ── Cron jobs ────────────────────────────────────────────────────────────
# Audit fix 1.5 — protects /api/cron/link-health, the weekly job that finds
# dead outbound links before your readers do. Scheduled in vercel.json.
#   openssl rand -hex 32
CRON_SECRET=


# ── Distributed rate limiting (optional but recommended) ─────────────────
# Audit fix 1.9 — the in-memory limiter does not work on serverless, since
# each request may hit a different instance. With these set, limits are
# enforced globally via Upstash's REST API (no extra npm dependency).
# Free tier is more than enough at this scale.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ── Newsletter delivery (audit fix 2.10) ──────────────────────────────────
# Set RESEND_API_KEY to actually send the double opt-in confirmation email.
# Without it, the newsletter stays an honest "launch waitlist" and no email is
# claimed or sent. Get a key at https://resend.com (free tier available).
# From address: on the free Resend tier you must verify your domain first, or
# use onboarding@resend.dev. In production, point it at your verified domain:
RESEND_API_KEY=
NEWSLETTER_FROM_EMAIL=CreatorAI Hub <onboarding@resend.dev>


# ── AI automation (idea #3 + #13) ─────────────────────────────────────────
# Optional. Enables:
#   - scripts/generate-blog.mjs (AI blog generator; also run by the scheduled
#     .github/workflows/blog-generate.yml GitHub Action)
#   - AI summary generation in the /api/news/refresh cron for /news
# At least one of the two keys below enables the blog generator. Either key
# enables AI news summarization (OpenAI preferred).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Override the model used by the blog generator / news summarizer.
# Blog generator default: gpt-4o-mini (OpenAI) or claude-3-5-haiku (Anthropic)
# News summarizer default: gpt-4o-mini
BLOG_AI_MODEL=
NEWS_AI_MODEL=

# ── Professional translation engine (i18n, 2026-08-07) ──────────────────
# Enables the LLM-based translation system (NOT Google Translate) for the
# 7 non-English locales (es/pt/fr/de/zh/ar/fa). Powers:
#   - /api/cron/translate  (daily incremental sync; also in the GitHub Action
#     .github/workflows/translate.yml which commits snapshot JSON so locales
#     work even without a database)
#   - /api/news/refresh    (newly ingested news is translated immediately)
#   - npm run translate:content / translate:ui / translate:status
#
# Uses the same key as the blog generator. Model is cheap and high quality;
# override if you want a different one.
OPENAI_API_KEY=
TRANSLATION_AI_MODEL=gpt-4o-mini

# ── FREE translation providers (alternative to OpenAI) ──────────────────
# Google Gemini — FREE tier, no credit card. Key at https://aistudio.google.com
#   (APIs → Create API key). Free quota is a few hundred requests/day —
#   enough for one language per day with --batch 4.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# OpenRouter — FREE key at https://openrouter.ai, free models need no credits.
#   Free-tier limit is ~50 requests/day → use --batch 8 and run across days.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Force a specific provider when more than one key is set:
# TRANSLATION_PROVIDER=openai|gemini|openrouter

# ── News backfill (v3, optional) ────────────────────────────────────────
# Free GNews key (https://gnews.io → Get free API key) to backfill the news
# archive with REAL stories from the start of 2026 (RSS feeds only serve
# recent items). Free tier: 100 requests/day. Without it, the archive grows
# via the daily cron from RSS only.
GNEWS_API_KEY=b36ce4db1bef69c3c627bef55baca476
